# --- One-time setup only (npm run db:setup). A PostgreSQL superuser connection. ---
# Remove it from .env on the production server after setup.
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres
DB_NAME=wardbook
# Long random passwords, for example from: openssl rand -base64 30
DB_OWNER_PASSWORD=CHANGE_ME_owner
DB_APP_PASSWORD=CHANGE_ME_app

# --- Scripts (migrations, create-hospital, create-admin, backups) ---
OWNER_DATABASE_URL=postgres://wardbook_owner:CHANGE_ME_owner@localhost:5432/wardbook

# --- The web server. MUST use wardbook_app: it is the only role bound by the access rules. ---
DATABASE_URL=postgres://wardbook_app:CHANGE_ME_app@localhost:5432/wardbook
PORT=3000
NODE_ENV=production
# Behind nginx or another reverse proxy on the same machine:
TRUST_PROXY=1
# Minutes without activity before a session ends (shared ward computers: keep it short).
IDLE_MINUTES=15

# --- Optional AI summaries. Leave empty to keep summaries template-only. ---
# Each hospital admin must also turn AI on for their hospital, after data protection approval.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Backups ---
BACKUP_DIR=/var/backups/wardbook
BACKUP_KEEP_DAYS=30
